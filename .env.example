# GEMINI_API_KEY: Required for Gemini AI workout, plan, and coach calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for Garmlink MCP OAuth callback).
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional: Pre-configured Garmlink MCP OAuth bearer token (normally handled automatically via in-app OAuth popup).
GARMLINK_ACCESS_TOKEN=""

# VITE_SUPABASE_URL & VITE_SUPABASE_ANON_KEY: Multi-user authentication & PostgreSQL storage.
# Create a free project at https://supabase.com and paste your Project URL and Anon Public Key.
# When omitted, RaceKit operates seamlessly with local multi-user state and instant demo accounts.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# GROQ_API_KEY: Fast primary LLM provider for sub-2s AI Coach and workout responses (llama-3.3-70b-versatile).
GROQ_API_KEY=""

# OWNER_PASSCODE: Passcode to unlock owner's personal Garmin watch sync (default 1126).
OWNER_PASSCODE="1126"
